# Copy to .env and fill in your OpenAI-compatible endpoint, secret, and model.
LLM_BASE_URL=https://your-endpoint.example/v1
LLM_API_KEY=
LLM_MODEL=

# JEV uses the native TypeSafe API, separately from the LLM endpoint above.
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
# Enable GPT fallback for native JEV handoffs (including journal construction).
JEV_ALLOW_LLM_ESCALATION=true
